{
  "name": "dark-fox",
  "version": "1.0.0",
  "description": "Dark Fox - a small, high-fidelity browser FPS built with three.js and fully procedural assets.",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/darkfox.js",
    "watch": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/darkfox.js --watch",
    "serve": "esbuild --servedir=. --serve=8080"
  },
  "license": "MIT",
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
